# Network binding. Keep 127.0.0.1 for local-only access;
# use 0.0.0.0 only on a trusted LAN or behind an authenticated reverse proxy/VPN.
HOST=127.0.0.1
PORT=8238
TZ=Asia/Shanghai

# If HTTPS is terminated by a reverse proxy, list its exact public origin(s).
# Do not use X-Forwarded-Proto as a substitute for this allowlist.
# TODO_ALLOWED_ORIGINS=https://todo.example.com

# Optional storage roots. Docker uses /data and /config; local development
# can leave these unset to keep runtime files beside the project.
# TODO_DATA_DIR=/data
# TODO_NOTES_DIR=/data/notes
# TODO_BACKUP_DIR=/data/backups
# TODO_CONFIG_DIR=/config

# Access protection is disabled by default; enable it in the Configuration
# Center (🔐 访问控制) or bootstrap it once with a password of >= 6 chars.
# TODO_AUTH_PASSWORD=choose-a-strong-password
# Hash the session cookie as Secure when HTTPS is terminated by a proxy
# the Node process cannot see.
# TODO_AUTH_SECURE_COOKIES=true
# TODO_AUTH_KEY=base64url-random-32-bytes

# Optional bootstrap defaults. The Configuration Center is the preferred place
# to save SMTP and WebDAV settings. Never commit real passwords or app tokens.
# TODO_SMTP_HOST=smtp.example.com# TODO_SMTP_PORT=465
# TODO_SMTP_SECURE=true
# TODO_SMTP_USER=your-account@example.com
# TODO_SMTP_PASS=your-smtp-app-password
# TODO_SMTP_FROM=your-account@example.com
# TODO_MAIL_RECIPIENTS=recipient@example.com
#
# TODO_WEBDAV_URL=https://dav.jianguoyun.com/dav/
# TODO_WEBDAV_USERNAME=your-jianguoyun-account@example.com
# TODO_WEBDAV_PASSWORD=your-jianguoyun-app-password
# TODO_WEBDAV_BACKUP_DIR=todo-app-backups
# TODO_BACKUP_AUTO=false
# TODO_BACKUP_INTERVAL_HOURS=24
# TODO_RESTORE_MAX_BYTES=134217728
