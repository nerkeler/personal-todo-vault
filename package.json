{
  "name": "personal-todo-vault",
  "version": "1.0.1",
  "description": "A self-hosted personal todo vault with reminders, Markdown notes, calendar views, and WebDAV backup.",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/nerkeler/personal-todo-vault.git",
  "dependencies": {
    "nodemailer": "^10.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "migrate": "node migrate.js",
    "migrate:snapshots": "node migrate-snapshots.js",
    "restore": "node restore.js",
